<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access levels (selection on the user form). Users without any level keep
         the standard Odoo behaviour: installing the module changes nothing. -->
    <!-- Odoo 19: groups shown as a selection on the user form belong to a privilege -->
    <record id="res_groups_privilege_contact_access" model="res.groups.privilege">
        <field name="name">Contacts Access</field>
        <field name="sequence">40</field>
        <field name="description">Category-based access to contacts.</field>
        <field name="placeholder">Standard</field>
        <field name="category_id" ref="base.module_category_master_data"/>
    </record>

    <record id="group_contact_access_restricted" model="res.groups">
        <field name="name">Restricted (by category)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_contact_access"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees and manages only the contacts of the access categories granted to the user or
            to one of their groups, plus internal users, companies and their own company.</field>
    </record>

    <record id="group_contact_access_full" model="res.groups">
        <field name="name">All Contacts</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_contact_access"/>
        <field name="implied_ids" eval="[Command.link(ref('group_contact_access_restricted'))]"/>
        <field name="comment">Full access to all contacts (multi-company rules still apply).</field>
    </record>

    <record id="group_contact_access_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_contact_access"/>
        <field name="implied_ids" eval="[Command.link(ref('group_contact_access_full'))]"/>
        <field name="comment">Manages access categories, their access lines and contact field filters.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Contact record rules. Group rules are OR-ed together and AND-ed with the
         global multi-company rule (base.res_partner_rule). -->
    <record id="rule_partner_restricted_read" model="ir.rule">
        <field name="name">Contacts: restricted users read granted categories</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[Command.link(ref('group_contact_access_restricted'))]"/>
        <field name="domain_force">contact_access_domain('read')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_partner_restricted_write" model="ir.rule">
        <field name="name">Contacts: restricted users edit granted categories</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[Command.link(ref('group_contact_access_restricted'))]"/>
        <field name="domain_force">contact_access_domain('write')</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_partner_restricted_create" model="ir.rule">
        <field name="name">Contacts: restricted users create in granted categories</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[Command.link(ref('group_contact_access_restricted'))]"/>
        <field name="domain_force">contact_access_domain('create')</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_partner_restricted_unlink" model="ir.rule">
        <field name="name">Contacts: restricted users delete in granted categories</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[Command.link(ref('group_contact_access_restricted'))]"/>
        <field name="domain_force">contact_access_domain('unlink')</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_partner_full" model="ir.rule">
        <field name="name">Contacts: all contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[Command.link(ref('group_contact_access_full'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Multi-company visibility of the categories themselves -->
    <record id="rule_contact_category_company" model="ir.rule">
        <field name="name">Contact categories: multi-company</field>
        <field name="model_id" ref="model_contact_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
