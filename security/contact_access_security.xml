<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access levels (selection on the user form). Users without any level keep
         the standard Odoo behaviour: installing the module changes nothing. -->
    <!-- Odoo 19: groups shown as a selection on the user form belong to a privilege -->
    <record id="res_groups_privilege_contact_access" model="res.groups.privilege">
        <field name="name">Contacts Access</field>
        <field name="sequence">40</field>
        <field name="description">Category-based access to contacts.</field>
        <field name="placeholder">Standard</field>
        <field name="category_id" ref="base.module_category_master_data"/>
    </record>

    <record id="group_contact_access_restricted" model="res.groups">
        <field name="name">Restricted (by category)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_contact_access"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees and manages only the contacts of the access categories granted to the user or
            to one of their groups, plus internal users, companies and their own company.</field>
    </record>

    <record id="group_contact_access_full" model="res.groups">
        <field name="name">All Contacts</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_contact_access"/>
        <field name="implied_ids" eval="[Command.link(ref('group_contact_access_restricted'))]"/>
        <field name="comment">Full access to all contacts (multi-company rules still apply).</field>
    </record>

    <record id="group_contact_access_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_contact_access"/>
        <field name="implied_ids" eval="[Command.link(ref('group_contact_access_full'))]"/>
        <field name="comment">Manages access categories, their access lines and contact field filters.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

</odoo>
